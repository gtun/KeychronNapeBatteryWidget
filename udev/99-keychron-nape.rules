# Let the logged-in user open the Keychron Nape Pro / Link-KM Raw HID interfaces.
# Install:  sudo cp 99-keychron-nape.rules /etc/udev/rules.d/
#           sudo udevadm control --reload-rules && sudo udevadm trigger
# Then unplug and replug the receiver/cable.

# Nape Pro over USB cable
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", ATTRS{idProduct}=="0440", MODE="0660", TAG+="uaccess"
# Keychron Link-KM 2.4 GHz receiver
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", ATTRS{idProduct}=="d026", MODE="0660", TAG+="uaccess"
